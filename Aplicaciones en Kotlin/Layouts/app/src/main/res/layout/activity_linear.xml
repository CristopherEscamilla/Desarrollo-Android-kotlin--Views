<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:weightSum="5">
    <!-- Pesos 1 y 4: resultado 20%, teclado 80%. -->
    <TextView
        android:id="@+id/result"
        style="@style/CalculatorDisplay"
        android:background="@drawable/bg_linear_display"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/bg_linear_keyboard">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_seven"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_seven"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_eight"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_eight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_nine"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_nine"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_divide"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_divide"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_four"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_four"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_five"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_five"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_six"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_six"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_multiply"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_multiply"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_one"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_one"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_two"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_two"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_three"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_three"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_subtract"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_subtract"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_zero"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_zero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_decimal"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_decimal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_equals"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_equals"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/key_add"
            style="@style/CalculatorKey.Linear"
            android:text="@string/calculator_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
